# Which model the agent runs on. Any provider init_chat_model supports, as
# "provider:model". Set the matching provider key below.
LLM_MODEL=anthropic:claude-sonnet-5
# Optional: a different model for the review pass (one structured call).
# LLM_CRITIC_MODEL=anthropic:claude-sonnet-5

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# For Azure OpenAI, use LLM_MODEL=azure_openai:<deployment> with:
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# OPENAI_API_VERSION=

# "fake" (default) runs against the fixtures in src/change_agent/fixtures.
# "rest" talks to a real instance using the three variables below.
SERVICENOW_MODE=fake
# SERVICENOW_INSTANCE_URL=https://devXXXXX.service-now.com
# SERVICENOW_USER=
# SERVICENOW_PASSWORD=

# Notice a normal change needs before CAB can review it.
CAB_LEAD_DAYS=5
